VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — the only AI provider. Powers:
#   - deepseek/deepseek-v4.1-flash: the text/vision brain (look composition,
#     item detection, personal-color analysis, dupe hunting, photo-edit
#     verification). Used by src/lib/ai.server.ts.
#   - meta/muse-image: outfit image generation (text-to-image, "Create my
#     look") and the outfit-on-selfie photo edit (image-to-image). Used by
#     src/lib/openrouter-image.server.ts and
#     src/lib/openrouter-photo-edit.server.ts.
OPENROUTER_API_KEY=

VITE_HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# Sanity — landing page CMS (edited in the MILA Studio). Server-only reads, so
# no VITE_ prefix.
SANITY_PROJECT_ID=8gum36g6
SANITY_DATASET=production

# Error monitoring — optional, safe to leave unset locally.
# Server-side: src/lib/sentry.server.ts. Client-side: src/lib/sentry-client.ts.
SENTRY_DSN=
VITE_SENTRY_DSN=

# PostHog — product analytics. Optional: unset disables all capture, same
# pattern as Sentry above. The project key is write-only and ships in the
# client bundle by design (PostHog calls it the "Project token" — find it in
# project settings). Capture hosts are allowlisted in the CSP in
# vite.config.ts (connect-src) — update both if the project moves regions.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

ADMIN_EMAIL=
ADMIN_PASSWORD=

USER_EMAIL=
USER_PASSWORD=

MODERATOR_EMAIL=
MODERATOR_PASSWORD=

# ---------------------------------------------------------------------------
# Paddle
#
# Sandbox and live are SEPARATE accounts with separate logins and catalogs.
#   sandbox -> sandbox-vendors.paddle.com   keys look like pdl_sdbx_...
#   live    -> vendors.paddle.com           keys look like pdl_live_...
# A pdl_live_ key here is always wrong: the app calls sandbox-api.paddle.com,
# and the products/prices only exist in the sandbox catalog.
#
# Paste secrets WHOLE and UNQUOTED. A truncated key fails as
# "authentication_malformed", which reads like a formatting bug, not a bad key.
# Sandbox API keys have three underscore segments after the prefix:
#   pdl_sdbx_apikey_<ulid>_<random>_<checksum>   (~70 chars)
# ---------------------------------------------------------------------------

# Outbound: your app -> Paddle. Sent as `Authorization: Bearer <key>`.
# Paddle > Developer tools > Authentication. Scopes needed:
#   transaction.read, subscription.read, subscription.write,
#   product.write, price.write
# Used by src/lib/paddle-sync.functions.ts and src/lib/subscriptions.functions.ts
PADDLE_SANDBOX_API_KEY=

# Inbound: Paddle -> your app. NOT an API key — it's the HMAC secret used to
# prove a webhook really came from Paddle (src/routes/api/webhooks/paddle.ts).
# Paddle > Developer tools > Notifications; each destination gets its own secret.
# Unused in local dev (Paddle can't reach localhost) — required in production,
# where it's the system of record for renewals, cancellations, payment failures
# and refunds. Locally, src/lib/paddle-sync.server.ts replays the checkout instead.
PADDLE_SANDBOX_WEBHOOK_SECRET=

# Client-side, safe to expose. Paddle.js won't open the checkout without it.
# Paddle > Developer tools > Authentication > Client-side tokens (test_...).
VITE_PADDLE_CLIENT_TOKEN=

# "sandbox" or "production". Wrong value sends real customers to the wrong
# account — Paddle.js defaults to production when this is unset.
VITE_PADDLE_ENV=sandbox

# Server-side counterpart of VITE_PADDLE_ENV — controls which Paddle API
# base URL, API key, and webhook secret src/lib/paddle-env.server.ts picks.
# Defaults to sandbox; set to "production" only on the production deployment.
PADDLE_ENV=sandbox

# Production counterparts of PADDLE_SANDBOX_API_KEY / PADDLE_SANDBOX_WEBHOOK_SECRET
# above — same scopes/setup, live Paddle account. Only required when
# PADDLE_ENV=production.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Transactional email (noreply)
#
# Mila sends its own mail — password-change notices, account-deletion
# confirmations, purchase receipts with a PDF attached — from a noreply
# address. Delivery goes through Resend's HTTP API (src/lib/mailer.server.ts),
# so the only thing needed here is an API key. Leave it unset and every send
# becomes a logged dry run: the app behaves identically, nothing leaves the
# machine. Set it in the Vercel project to turn mail on in production.
#
# MAIL_FROM must be a verified sender in Resend (a domain you have added and
# whose DNS records are in place) or Resend rejects the send. Defaults to
# "Mila <noreply@mila.app>" when unset.
RESEND_API_KEY=
MAIL_FROM=

# ---------------------------------------------------------------------------
# Daily membership sweep
#
# Vercel Cron calls GET /api/v1/cron/membership-maintenance once a day
# (vercel.json) with `Authorization: Bearer $CRON_SECRET`. The sweep gives every
# live subscriber today's styling credits and takes subscriptions whose paid
# period has ended out of force, so a membership that stops paying stops
# accruing. Without this var the route answers 503 and the sweep never runs —
# webhooks and the on-use refill still work, but nothing catches a missed
# renewal. Set it in the Vercel project (any long random string).
CRON_SECRET=

# Public origin used for canonical, og:url and og:image tags (no trailing path).
# Unset: falls back to a custom production domain on the Vercel project (a
# non-vercel.app VERCEL_PROJECT_PRODUCTION_URL), then the live deployment. Only
# these hosts and the live deployment are indexed; every other host (previews,
# nicoleDev, localhost) is served with noindex. A custom domain on live works
# without setting this, but setting it is clearer.
# public/robots.txt and public/sitemap.xml are static and name the live origin.
SITE_URL=

# Kill switch: SITE_INDEXING=off forces noindex on every page of a deployment,
# for a test project that must never be indexed. Unset or any other value leaves
# indexing as above, so live is never switched off by omission.
# SITE_INDEXING=
